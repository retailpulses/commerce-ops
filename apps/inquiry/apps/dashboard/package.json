{
  "name": "inquiry-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:release": "node scripts/generate-release-metadata.mjs",
    "prebuild": "npm run generate:release",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name inquiry-dashboard",
    "pretypecheck": "npm run generate:release",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "pretest": "npm run generate:release",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@cloudflare/workers-types": "^5.20260714.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "wrangler": "^4.112.0"
  }
}
