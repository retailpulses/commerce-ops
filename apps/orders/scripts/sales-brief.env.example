# Multi-Platform Sales Brief — env vars
# Install as a protected root-owned template, then provision real values
# separately for the rp-ordermgmt service user.
#
# VPS path: /etc/ordermgmt/sales-brief.env (mode 0600, owner rp-ordermgmt)
SALES_BRIEF_FRESHNESS_SCOPES=mercari:WMyisFmhbGWyVAPEwsfirn,mercari:ZaMyGWzp6hUdgDh5E9ADob,mercari:2JGrmZqojnBMfdWrtP2xk3,mercari:2JMLHBxjiFHDr55jMwA7fs
SALES_BRIEF_MAX_FRESHNESS_MINUTES=90
# Normally unset. An approved live manual run may assert the current scheduled
# JST slot, but cannot backdate, predate, or bypass the six scheduled hours.
# SALES_BRIEF_DELIVERY_SLOT=

SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WECOM_WEBHOOK_URL=
