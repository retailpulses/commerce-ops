# OrderMgmt Pipeline Environment — deployed to /etc/ordermgmt/pipeline.env
#
# This file is committed as a template with placeholder values.
# The production copy at /etc/ordermgmt/pipeline.env must be:
#   1. Created manually with mode 0600 (chmod 600)
#   2. Populated with real secrets (never commit secrets to git)
#   3. Owned by root:root (readable only by root + rp-ordermgmt)
#
# All phase invocations through pipeline-scheduler@.service load this file
# via EnvironmentFile=/etc/ordermgmt/pipeline.env.

# ── Required ──────────────────────────────────────────────────────────

# Baserow API token (Products-table enrichment + legacy Baserow writes)
BASEROW_DATABASE_TOKEN=<set-via-env-file>

# GigaB2B HMAC credentials (shipment push + tracking pull)
GIGA_CLIENT_ID=<set-via-env-file>
GIGA_CLIENT_SECRET=<set-via-env-file>

# Supabase connection (canonical DB for sales, shipments, templates)
DATABASE_BACKEND=supabase
SUPABASE_URL=https://gqeyfhshxdiyhugvmbuk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<set-via-env-file>

# Local marketplace credentials for the target VPS orchestrator.
# Keep the token file outside the release tree and readable by rp-ordermgmt.
MERCARI_TOKENS_PATH=/etc/ordermgmt/mercari_tokens.md
RAKUTEN_SERVICE_SECRET=<set-via-env-file>
RAKUTEN_LICENSE_KEY=<set-via-env-file>
RAKUTEN_RMS_BASE=https://api.rms.rakuten.co.jp/es/2.0

# Relay authentication retained for Worker-compatible/manual relay paths.
MERCARI_RUNNER_BASE_URL=https://worker-order.homesbliss.net
MERCARI_RELAY_SECRET=<set-via-env-file>

# ── Optional ──────────────────────────────────────────────────────────

# Run limit per phase invocation (default: 100)
ORDER_MGMT_LIMIT=100

# Canonical orchestrator is fail-closed by default. Live mode additionally
# requires ORCHESTRATOR_LIVE_ENABLED=true and at least one explicit capability
# flag below. Every enabled unit also reads `order_scheduler_ownership` and
# requires an unexpired `vps_order_orchestrator` record matching both values
# below, with the legacy scheduler proven disabled. Never enable a flag before
# disabling and reading back the matching legacy production trigger.
RELEASE_VERSION=<exact-deployed-git-sha>
ORCHESTRATOR_RUNTIME_HOST=<exact-system-hostname>
ORCHESTRATOR_REQUIRE_IMMUTABLE_RELEASE=true
ORCHESTRATOR_MODE=shadow
ORCHESTRATOR_LIVE_ENABLED=false
ORCHESTRATOR_ENABLE_MESSAGE_INGESTION=false
ORCHESTRATOR_ENABLE_MERCARI_LIFECYCLE=false
ORCHESTRATOR_ENABLE_RAKUTEN_LIFECYCLE=false
ORCHESTRATOR_ENABLE_MERCARI_ELIGIBILITY=false
ORCHESTRATOR_ENABLE_MERCARI_PROJECTION=false
ORCHESTRATOR_ENABLE_RAKUTEN_CONFIRMATION=false
ORCHESTRATOR_ENABLE_RAKUTEN_PROJECTION=false
ORCHESTRATOR_ENABLE_MERCARI_GIGA_OUTBOUND=false
ORCHESTRATOR_ENABLE_RAKUTEN_GIGA_OUTBOUND=false
ORCHESTRATOR_ENABLE_MERCARI_TRACKING=false
ORCHESTRATOR_ENABLE_RAKUTEN_TRACKING=false
ORCHESTRATOR_ENABLE_MERCARI_CLOSE=false
ORCHESTRATOR_ENABLE_RAKUTEN_CLOSE=false
ORCHESTRATOR_ENABLE_INTEGRITY_AUDIT=false
ORCHESTRATOR_ENABLE_PAYMENT_REMINDERS=false

# Timezone for scheduled operations
TZ=Asia/Tokyo

# Portal API access (if running portal-adjacent operations)
PORTAL_ACCESS_TOKEN=<set-via-env-file>

# LLM (AI reply generation — optional)
OPENAI_API_KEY=<set-via-env-file>
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=500

# Admin auth (shared with Worker for cross-system admin endpoints)
ORDER_MGMT_ADMIN_SECRET=<set-via-env-file>
GIGA_SYNC_ADMIN_SECRET=<set-via-env-file>
CATALOG_OWNER_API_BASE_URL=https://rpagentos.pages.dev
ORDERMGMT_CATALOG_API_TOKEN=<set-via-env-file>

# Portal product enrichment
PORTAL_PRODUCTS_TABLE_ID=886994
PORTAL_COMMISSION_RATE_MERCARI=0.10

# Giga push retry window (minutes since last push before retry)
GIGA_OUTBOUND_RETRY_AFTER_MINUTES=30
