# TRANSITIONAL: per-platform timer. Will be consolidated in Phase B
# (channel-stage timers). See issue TBD.
#
# push_rakuten_orders_to_giga — every 10 min Rakuten shipment push to GigaB2B.
# Phase: push_rakuten_orders_to_giga  Kind: push / external_write  Risk: High

[Unit]
Description=OrderMgmt — push_rakuten_orders_to_giga (GigaB2B push)
Documentation=https://github.com/retailpulses/OrderMgmt

[Timer]
Unit=pipeline-scheduler@push_rakuten_orders_to_giga.service
OnCalendar=*-*-* *:08,18,28,38,48,58:00
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
