# TRANSITIONAL: per-platform timer. Will be consolidated in Phase B
# (channel-stage timers). See issue TBD.
#
# reconcile_cancellations — daily Mercari cancellation reconciliation.
# Worker cron: 50 14 * * * (UTC) = 23:50 JST. VPS timezone is Asia/Tokyo,
# specified explicitly for clarity.
# Phase: reconcile_cancellations  Kind: reconcile / internal_write  Risk: Medium

[Unit]
Description=OrderMgmt — reconcile_cancellations (daily reconciliation)
Documentation=https://github.com/retailpulses/OrderMgmt

[Timer]
Unit=pipeline-scheduler@reconcile_cancellations.service
OnCalendar=*-*-* 23:50:00 Asia/Tokyo
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
