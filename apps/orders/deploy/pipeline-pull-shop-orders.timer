# TRANSITIONAL: per-platform timer. Will be consolidated in Phase B
# (channel-stage timers). See issue TBD.
#
# pull_shop_orders — hourly Mercari order ingestion.
# Phase: pull_shop_orders  Kind: pull / internal_write  Risk: Medium

[Unit]
Description=OrderMgmt — pull_shop_orders (Mercari ingest)
Documentation=https://github.com/retailpulses/OrderMgmt

[Timer]
Unit=pipeline-scheduler@pull_shop_orders.service
OnCalendar=*-*-* *:01:00
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
