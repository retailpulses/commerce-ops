# TRANSITIONAL: per-platform timer. Will be consolidated in Phase B
# (channel-stage timers). See issue TBD.
#
# close_shop_orders — every 10 min Mercari order close on marketplace.
# Phase: close_shop_orders  Kind: push / external_write  Risk: High

[Unit]
Description=OrderMgmt — close_shop_orders (Mercari close)
Documentation=https://github.com/retailpulses/OrderMgmt

[Timer]
Unit=pipeline-scheduler@close_shop_orders.service
OnCalendar=*-*-* *:09,19,29,39,49,59:00
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
