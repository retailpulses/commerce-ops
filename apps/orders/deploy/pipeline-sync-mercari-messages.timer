# TRANSITIONAL: per-platform timer. Will be consolidated in Phase B
# (channel-stage timers). See issue TBD.
#
# sync_mercari_messages — every 10 min Mercari buyer message sync.
# Phase: sync_mercari_messages  Kind: pull / internal_write  Risk: Medium

[Unit]
Description=OrderMgmt — sync_mercari_messages (Mercari messages)
Documentation=https://github.com/retailpulses/OrderMgmt

[Timer]
Unit=pipeline-scheduler@sync_mercari_messages.service
OnCalendar=*-*-* *:03,13,23,33,43,53:00
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
