# TRANSITIONAL: per-platform timer. Will be consolidated in Phase B
# (channel-stage timers). See issue TBD.
#
# pull_giga_tracking — every 10 min tracking pull from GigaB2B.
# Runs BEFORE close_shop_orders (:09) so tracking is available for close.
# Phase: pull_giga_tracking  Kind: pull / internal_write  Risk: Medium

[Unit]
Description=OrderMgmt — pull_giga_tracking (tracking pull)
Documentation=https://github.com/retailpulses/OrderMgmt

[Timer]
Unit=pipeline-scheduler@pull_giga_tracking.service
OnCalendar=*-*-* *:05,15,25,35,45,55:00
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
