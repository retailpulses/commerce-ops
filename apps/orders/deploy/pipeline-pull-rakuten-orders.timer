# TRANSITIONAL: per-platform timer. Will be consolidated in Phase B
# (channel-stage timers). See issue TBD.
#
# pull_rakuten_orders — hourly Rakuten order ingestion.
# Phase: pull_rakuten_orders  Kind: pull / internal_write  Risk: Medium

[Unit]
Description=OrderMgmt — pull_rakuten_orders (Rakuten ingest)
Documentation=https://github.com/retailpulses/OrderMgmt

[Timer]
Unit=pipeline-scheduler@pull_rakuten_orders.service
OnCalendar=*-*-* *:02:00
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
