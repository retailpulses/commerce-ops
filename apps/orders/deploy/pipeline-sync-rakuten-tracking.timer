# TRANSITIONAL: per-platform timer. Will be consolidated in Phase B
# (channel-stage timers). See issue TBD.
#
# sync_rakuten_tracking — every 10 min Rakuten tracking sync from GigaB2B.
# 5 runs/hour (*:10,20,30,40,50) — deliberately excludes :00 to match
# Worker cron exactly. The Worker schedule omits :00 from its 6-position
# cron expression (10,20,30,40,50 — only 5 values).
# Phase: sync_rakuten_tracking  Kind: pull / internal_write  Risk: Medium

[Unit]
Description=OrderMgmt — sync_rakuten_tracking (Rakuten tracking)
Documentation=https://github.com/retailpulses/OrderMgmt

[Timer]
Unit=pipeline-scheduler@sync_rakuten_tracking.service
OnCalendar=*-*-* *:10,20,30,40,50:00
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
