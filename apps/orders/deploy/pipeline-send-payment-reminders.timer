# TRANSITIONAL: per-platform timer. Will be consolidated in Phase B
# (channel-stage timers). See issue TBD.
#
# send_payment_reminders — daily payment reminder messages to customers.
# Worker cron: 0 23 * * * (UTC) = 08:00 JST. VPS timezone is Asia/Tokyo,
# specified explicitly for clarity.
# Phase: send_payment_reminders  Kind: push / external_write  Risk: High

[Unit]
Description=OrderMgmt — send_payment_reminders (daily reminders)
Documentation=https://github.com/retailpulses/OrderMgmt

[Timer]
Unit=pipeline-scheduler@send_payment_reminders.service
OnCalendar=*-*-* 08:00:00 Asia/Tokyo
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
