# TRANSITIONAL: per-platform timer. Will be consolidated in Phase B
# (channel-stage timers). See issue TBD.
#
# reconcile_end_to_end — every 10 min end-to-end healing pass.
# 5 runs/hour (*:11,21,31,41,51) — matches Worker cron exactly.
# Phase: reconcile_end_to_end  Kind: reconcile / read_only  Risk: Low

[Unit]
Description=OrderMgmt — reconcile_end_to_end (healing pass)
Documentation=https://github.com/retailpulses/OrderMgmt

[Timer]
Unit=pipeline-scheduler@reconcile_end_to_end.service
OnCalendar=*-*-* *:11,21,31,41,51:00
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
