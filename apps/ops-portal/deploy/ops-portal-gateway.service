[Unit]
Description=Ops Portal canonical path gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ops-gateway
Group=ops-gateway
WorkingDirectory=/opt/ops-portal-gateway/current/gateway
EnvironmentFile=/etc/ops-portal-gateway.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
