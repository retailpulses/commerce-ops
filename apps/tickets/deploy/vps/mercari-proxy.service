[Unit]
Description=Mercari GraphQL HTTP Proxy (for CF Worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /root/mercari-proxy/server.py 9000
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
